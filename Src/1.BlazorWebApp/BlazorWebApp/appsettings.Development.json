{
  "OpenTelemetry": {
    "ServiceName": "BlazorServerApp",
    "Endpoint": "http://localhost:4317"
  },
  "dashboard": {
    "id": null,
    "title": "Blazor Server Metrics",
    "tags": [ "blazor", "metrics" ],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Page Views",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(blazor_page_views_total) by (page)",
            "legendFormat": "{{page}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Database Query Duration",
        "type": "heatmap",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_milliseconds_bucket[5m])) by (le, query))",
            "legendFormat": "{{query}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "User Logins",
        "type": "bargauge",
        "targets": [
          {
            "expr": "sum(user_logins_total) by (user)",
            "legendFormat": "{{user}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Memory Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "process_memory_bytes / 1024 / 1024",
            "legendFormat": "MB"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenTelemetry": "Information"
    }
  }
}