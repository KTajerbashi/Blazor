@page "/reports"
@rendermode InteractiveServer
@using BlazorWebApp.Repositories
@using FastReport
@using FastReport.Web
@using FastReport.Export.PdfSimple;
@inject IReportGenerator ReportGenerator

<PageTitle>Reports</PageTitle>

<h3>FastReport with Static Data</h3>

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary me-2" @onclick="GenerateOrdersReport"
                disabled="@IsGenerating">
            Generate Orders Report
        </button>
        <button class="btn btn-success me-2" @onclick="GenerateProductsReport"
                disabled="@IsGenerating">
            Generate Products Report
        </button>
        <button class="btn btn-info" @onclick="ClearReport">Clear Report</button>
    </div>
</div>

@if (IsGenerating)
{
    <div class="alert alert-warning">
        <span class="spinner-border spinner-border-sm" role="status"></span>
        Generating report...
    </div>
}

@if (!string.IsNullOrEmpty(DownloadUrl))
{
    <div class="alert alert-info">
        Report generated successfully!
        <a href="@DownloadUrl" download="@DownloadFileName" class="btn btn-sm btn-outline-primary ms-2">
            Download PDF
        </a>
    </div>
}

@if (WebReport != null && WebReport.Report != null)
{
    <div class="mt-3">
        <h4>Report Preview:</h4>
        @try
        {
            @(WebReport.RenderSync())
        }
        catch (Exception ex)
        {
            <div class="alert alert-danger">
                Error rendering report: @ex.Message
            </div>
        }
    </div>
}
else if (WebReport != null && WebReport.Report == null)
{
    <div class="alert alert-warning">
        Report is null. Please generate a report first.
    </div>
}

@code {
    private WebReport? WebReport { get; set; }
    private string? DownloadUrl { get; set; }
    private string? DownloadFileName { get; set; }
    private bool IsGenerating { get; set; }

    private async Task GenerateOrdersReport()
    {
        await GenerateReportAsync(() => ReportGenerator.GenerateOrdersReport(),"orders_report.pdf");
    }

    private async Task GenerateProductsReport()
    {
        await GenerateReportAsync(
            () => ReportGenerator.GenerateProductsReport(),
            "products_report.pdf"
        );
    }

    private async Task GenerateReportAsync(Func<byte[]> reportGenerator, string fileName)
    {
        try
        {
            IsGenerating = true;
            StateHasChanged();

            // Add a small delay to allow UI to update
            await Task.Delay(10);

            var reportBytes = reportGenerator();
            await HandleReportGeneration(reportBytes, fileName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating report: {ex.Message}");
        }
        finally
        {
            IsGenerating = false;
            StateHasChanged();
        }
    }

    private async Task HandleReportGeneration(byte[] reportBytes, string fileName)
    {
        // Create download link
        DownloadUrl = await GenerateDownloadLinkAsync(reportBytes);
        DownloadFileName = fileName;

        // Create and load the report for WebReport display
        try
        {
            WebReport = new WebReport();

            // Create a new report instance and load the PDF bytes
            var report = new Report();
            using var ms = new MemoryStream(reportBytes);

            // Try to load the PDF as a report (this might not work for PDF display)
            // Alternatively, you might want to store the original report object
            report.Load(ms);

            WebReport.Report = report;
            WebReport.Width = "100%";
            WebReport.Height = "600px";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading report for display: {ex.Message}");
            // Fallback: just show download link without preview
            WebReport = null;
        }

        StateHasChanged();
    }

    private async Task<string> GenerateDownloadLinkAsync(byte[] data)
    {
        return await Task.Run(() =>
        {
            var base64 = Convert.ToBase64String(data);
            return $"data:application/pdf;base64,{base64}";
        });
    }

    private void ClearReport()
    {
        WebReport = null;
        DownloadUrl = null;
        DownloadFileName = null;
        StateHasChanged();
    }
}