@page "/Login-With-2fa"


<PageContainer Title="Login With 2fa Page">
    <EditForm Model="@Model" OnValidSubmit="HandleLoginWith2fa">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <input type="hidden" @bind="Model.RememberMe" />

        <div class="form-group">
            <label for="twoFactorCode">Authenticator Code</label>
            <InputText id="twoFactorCode" @bind-Value="Model.TwoFactorCode" class="form-control" autocomplete="off" />
            <ValidationMessage For="@(() => Model.TwoFactorCode)" />
        </div>

        <div class="form-check">
            <InputCheckbox id="rememberMachine" @bind-Value="Model.RememberMachine" class="form-check-input" />
            <label for="rememberMachine" class="form-check-label">Remember this machine</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Log in</button>
    </EditForm>
    <p>
        Don't have access to your authenticator device? You can
        <a href="/login-with-recovery-code?returnUrl=@ReturnUrl">log in with a recovery code</a>.
    </p>
</PageContainer>

@code {
    private LoginWith2faModel Model = new LoginWith2faModel();
    private string ReturnUrl { get; set; } = "/";

    protected override void OnInitialized()
    {
        // Fetch return URL from the query string
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var returnUrl))
        {
            ReturnUrl = returnUrl;
        }
    }

    private async Task HandleLoginWith2fa()
    {
        // Call your API or backend to handle the 2FA login request
        var response = await Http.PostAsJsonAsync("api/account/login-with-2fa", Model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo(ReturnUrl); // Redirect to the return URL
        }
        else
        {
            // Handle error (e.g., display a message)
        }
    }

    public class LoginWith2faModel
    {
        [Required(ErrorMessage = "Authenticator code is required.")]
        public string TwoFactorCode { get; set; }

        public bool RememberMachine { get; set; }

        public bool RememberMe { get; set; }
    }
}