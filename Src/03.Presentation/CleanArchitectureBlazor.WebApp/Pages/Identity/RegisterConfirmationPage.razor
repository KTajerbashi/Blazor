@page "/Register-Confirmation"

<PageContainer Title="Register Confirmation Page">
    @if (DisplayConfirmAccountLink)
    {
        <p>
            This app does not currently have a real email sender registered, see <a href="https://aka.ms/aspaccountconf">these docs</a> for how to configure a real email sender.
            Normally this would be emailed: <a id="confirm-link" href="@EmailConfirmationUrl">Click here to confirm your account</a>
        </p>
    }
    else
    {
        <p>
            Please check your email to confirm your account.
        </p>
    }
</PageContainer>

@code {
    private bool DisplayConfirmAccountLink { get; set; } = true; // Set this based on your logic
    private string EmailConfirmationUrl { get; set; } = "/confirm-email"; // Set this based on your logic

    protected override void OnInitialized()
    {
        // Fetch the display confirm account link and email confirmation URL from the query string or backend
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("displayConfirmAccountLink", out var displayConfirmAccountLink))
        {
            DisplayConfirmAccountLink = bool.Parse(displayConfirmAccountLink);
        }
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("emailConfirmationUrl", out var emailConfirmationUrl))
        {
            EmailConfirmationUrl = emailConfirmationUrl;
        }
    }
}