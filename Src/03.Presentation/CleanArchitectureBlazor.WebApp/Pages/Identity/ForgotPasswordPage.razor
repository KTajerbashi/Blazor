@page "/Forgot-Password"

<PageContainer Title="Forgot Password Page">
    <h2>Enter your email.</h2>
    <hr />
    <EditForm Model="@Model" OnValidSubmit="HandleForgotPassword">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Model.Email" class="form-control" placeholder="name@example.com" />
            <ValidationMessage For="@(() => Model.Email)" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Reset Password</button>
    </EditForm>
</PageContainer>

@code {
    private ForgotPasswordModel Model = new ForgotPasswordModel();

    private async Task HandleForgotPassword()
    {
        // Call your API or backend to handle the forgot password request
        var response = await Http.PostAsJsonAsync("api/account/forgot-password", Model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/forgot-password-confirmation"); // Redirect to confirmation page
        }
        else
        {
            // Handle error (e.g., display a message)
        }
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; }
    }
}