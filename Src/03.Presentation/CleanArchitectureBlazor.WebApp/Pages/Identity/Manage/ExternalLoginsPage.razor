@page "/external-logins"

<PageContainer Title="External Logins Page">
    <AlertMessage Message="@StatusMessage" />
    @if (CurrentLogins?.Count > 0)
    {
        <h3>Registered Logins</h3>
        <table class="table">
            <tbody>
                @foreach (var login in CurrentLogins)
                {
                    <tr>
                        <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                        <td>
                            @if (ShowRemoveButton)
                            {
                                <button type="button" class="btn btn-primary" @onclick="() => RemoveLogin(login.LoginProvider, login.ProviderKey)" title="Remove this @login.ProviderDisplayName login from your account">
                                    Remove
                                </button>
                            }
                            else
                            {
                                @: &nbsp;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (OtherLogins?.Count > 0)
    {
        <h4>Add another service to log in.</h4>
        <hr />
        <div id="socialLoginList">
            <p>
                @foreach (var provider in OtherLogins)
                {
                    <button id="@($"link-login-button-{provider.Name}")" type="button" class="btn btn-primary" @onclick="() => LinkLogin(provider.Name)" title="Log in using your @provider.DisplayName account">
                        @provider.DisplayName
                    </button>
                }
            </p>
        </div>
    }
</PageContainer>






@code {
    private string StatusMessage { get; set; }
    private List<ExternalLogin> CurrentLogins { get; set; } = new();
    private List<ExternalLoginProvider> OtherLogins { get; set; } = new();
    private bool ShowRemoveButton { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Fetch external logins and other providers from the backend
        // var response = await Http.GetFromJsonAsync<ExternalLoginsResponse>("api/account/external-logins");
        // if (response != null)
        // {
        //     CurrentLogins = response.CurrentLogins;
        //     OtherLogins = response.OtherLogins;
        //     ShowRemoveButton = response.ShowRemoveButton;
        // }
    }

    private async Task RemoveLogin(string loginProvider, string providerKey)
    {
        var request = new RemoveLoginRequest { LoginProvider = loginProvider, ProviderKey = providerKey };
        var response = await Http.PostAsJsonAsync("api/account/remove-login", request);

        if (response.IsSuccessStatusCode)
        {
            StatusMessage = "The external login was removed.";
            await OnInitializedAsync(); // Refresh the list
        }
        else
        {
            StatusMessage = "An error occurred while removing the external login.";
        }
    }

    private async Task LinkLogin(string provider)
    {
        var response = await Http.PostAsJsonAsync("api/account/link-login", new { Provider = provider });

        if (response.IsSuccessStatusCode)
        {
            var redirectUrl = await response.Content.ReadAsStringAsync();
            Navigation.NavigateTo(redirectUrl, forceLoad: true); // Redirect to the external provider
        }
        else
        {
            StatusMessage = "An error occurred while linking the external login.";
        }
    }

    // Models
    public class ExternalLogin
    {
        public string LoginProvider { get; set; }
        public string ProviderDisplayName { get; set; }
        public string ProviderKey { get; set; }
    }

    public class ExternalLoginProvider
    {
        public string Name { get; set; }
        public string DisplayName { get; set; }
    }

    public class ExternalLoginsResponse
    {
        public List<ExternalLogin> CurrentLogins { get; set; }
        public List<ExternalLoginProvider> OtherLogins { get; set; }
        public bool ShowRemoveButton { get; set; }
    }

    public class RemoveLoginRequest
    {
        public string LoginProvider { get; set; }
        public string ProviderKey { get; set; }
    }
}