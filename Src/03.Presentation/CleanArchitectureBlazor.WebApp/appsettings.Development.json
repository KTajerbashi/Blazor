{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server =TAJERBASHI; Database=Blazor;User Id = sa;Password=12341234; MultipleActiveResultSets=true; Encrypt = false",
    //"DefaultConnection": "Server =172.20.1.20\\DEV; Database=Blazor;User Id = sa;Password=soft157703ware; MultipleActiveResultSets=true; Encrypt = false",
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "Console : {Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }, // Console sink
      {
        "Name": "File", // File sink
        "Args": {
          "path": "logs/CleanArchitectureBlazor.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760, // 10 MB
          "rollOnFileSizeLimit": true, // Create a new file when the size limit is reached
          "retainedFileCountLimit": 10 // Keep only the last 10 files
        }
      },
      {
        "Name": "MSSqlServer", // Database sink
        "Args": {
          "connectionString": "Server=TAJERBASHI;Database=Blazor;User Id=sa;Password=12341234;MultipleActiveResultSets=true;Encrypt=false",
          //"connectionString": "Server =172.20.1.20\\DEV; Database=Blazor;User Id = sa;Password=soft157703ware; MultipleActiveResultSets=true; Encrypt = false",
          "schemaName": "Log",
          "tableName": "EventLogs",
          "autoCreateSqlTable": true,
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ], // Remove only Properties, keep MessageTemplate
            "customColumns": [
              {
                "ColumnName": "UserId",
                "DataType": "nvarchar",
                "DataLength": 50,
                "AllowNull": true
              },
              {
                "ColumnName": "SourceContext",
                "DataType": "nvarchar",
                "DataLength": 128,
                "AllowNull": true
              },
              {
                "ColumnName": "RequestId",
                "DataType": "nvarchar",
                "DataLength": 50,
                "AllowNull": true
              }
            ]
          }
        }
      }
    ],
    "Enrich": [ "WithMachineName", "WithEnvironmentUserName" ],
    "Properties": {
      "Application": "CleanArchitectureBlazor"
    }
  }
}
