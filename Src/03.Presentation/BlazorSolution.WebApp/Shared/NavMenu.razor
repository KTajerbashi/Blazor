<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand  text-center w-100" href="">Blazor</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>


<div class="@NavMenuCssClass nav-scrollable  shadow" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <!-- Home Link -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Panel
            </NavLink>
        </div>

        <!-- Dynamic Navigation Links -->
        @foreach (var nav in NavModels)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@nav.Link" Match="NavLinkMatch.Prefix">
                    <span class="@nav.Icon" aria-hidden="true"></span> @nav.Title
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    public class NavModel
    {
        public string Link { get; set; }
        public string Title { get; set; }
