@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<hr />
<br />
<h1 style="background:red; padding:10px;border-radius:10px;">@TitleName</h1>
<br />
<hr />
@foreach (var item in Datalist)
{
    <h1 style="background:blue;color:wheat;margin:2px 0;">@item</h1>
}
Welcome to your new app.

@code {
    public List<string> Datalist { get; set; }
    public string TitleName { get; set; }
    protected override void OnInitialized()
    {
        TitleName = "Tajerbashi";
        Datalist = Enumerable.Range(1, 10).Select((counter, index) => $"{index} : {counter}").ToList();
    }
}
