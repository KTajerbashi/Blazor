@page "/access-denied"
<PageContainer Title="@Title" AdditionalClasses="text-center">
    <div class="mt-5 pt-5 alert alert-danger text-center">
        <h1 class="text-danger">@Title</h1>
        <hr />
        <p class="text-danger">You do not have access to this resource.</p>
    </div>
</PageContainer>


@code {
    public string Title { get; set; } = "Access denied Page";
}
