@page "/Login-With-Recovery-Code"

<PageContainer Title="Logout Page">
    <div class="container d-flex flex-row justify-content-around text-center gap-1">
        <div class="col-12 border border-1">
            <p>
                You have requested to log in with a recovery code. This login will not be remembered until you provide
                an authenticator app code at log in or disable 2FA and log in again.
            </p>

            <div class="row">
                <div class="col-md-4">
                    <EditForm Model="@Model" OnValidSubmit="HandleLoginWithRecoveryCode">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-group">
                            <label for="recoveryCode">Recovery Code</label>
                            <InputText id="recoveryCode" @bind-Value="Model.RecoveryCode" class="form-control" placeholder="RecoveryCode" />
                            <ValidationMessage For="@(() => Model.RecoveryCode)" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Log in</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

</PageContainer>


@code {
    private LoginWithRecoveryCodeModel Model = new LoginWithRecoveryCodeModel();

    private async Task HandleLoginWithRecoveryCode()
    {
        // Call your API or backend to handle the recovery code login request
        var response = await Http.PostAsJsonAsync("api/account/login-with-recovery-code", Model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/"); // Redirect to the home page or return URL
        }
        else
        {
            // Handle error (e.g., display a message)
        }
    }

    public class LoginWithRecoveryCodeModel
    {
        [Required(ErrorMessage = "Recovery code is required.")]
        public string RecoveryCode { get; set; }
    }
}