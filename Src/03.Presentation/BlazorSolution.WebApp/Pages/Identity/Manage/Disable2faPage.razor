@page "/disable-2fa"
@using BlazorSolution.WebApp.Pages.Components



<PageContainer Title="Disable 2fa Page">
    <AlertMessage Message="@StatusMessage" />

    <div class="alert alert-warning " role="alert">
        <p>
            <strong>This action only disables 2FA.</strong>
        </p>
        <p>
            Disabling 2FA does not change the keys used in authenticator apps. If you wish to change the key
            used in an authenticator app you should <a href="/reset-authenticator">reset your authenticator keys.</a>
        </p>
    </div>

    <div>
        <button class="btn btn-danger" @onclick="Disable2fa">Disable 2FA</button>
    </div>
</PageContainer>

@code {
    private string StatusMessage { get; set; }

    private async Task Disable2fa()
    {
        // Call your API or backend to disable 2FA
        var response = await Http.PostAsync("api/account/disable-2fa", null);

        if (response.IsSuccessStatusCode)
        {
            StatusMessage = "2FA has been disabled.";
            Navigation.NavigateTo("/"); // Redirect to home or another page
        }
        else
        {
            StatusMessage = "An error occurred while disabling 2FA.";
        }
    }
}