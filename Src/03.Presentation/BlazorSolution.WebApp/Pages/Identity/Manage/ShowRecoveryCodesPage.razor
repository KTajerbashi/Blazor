@page "/show-recovery-codes"


<PageContainer Title="Show Recovery Codes Page">
    <AlertMessage Message="@StatusMessage" />
    <div class="alert alert-warning" role="alert">
        <p>
            <strong>Put these codes in a safe place.</strong>
        </p>
        <p>
            If you lose your device and don't have the recovery codes, you will lose access to your account.
        </p>
    </div>
    <div>
        @for (var row = 0; row < RecoveryCodes.Length; row++)
        {
            <code class="recovery-code btn btn-outline-dark m-2">@RecoveryCodes[row]</code>
        }
    </div>
</PageContainer>



@code {
    private string StatusMessage { get; set; }
    private string[] RecoveryCodes { get; set; } = Array.Empty<string>();

    protected override void OnInitialized()
    {
        // Fetch recovery codes from the backend or state management
        RecoveryCodes = new[] { "CODE1", "CODE2", "CODE3", "CODE4", "CODE5", "CODE6" }; // Replace with actual recovery codes
    }
}