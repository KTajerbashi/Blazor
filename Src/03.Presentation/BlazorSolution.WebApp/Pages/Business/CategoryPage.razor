@page "/category"
@using BlazorSolution.Core.Application.Categories
@using BlazorSolution.Core.Domain.Categories.Entities
@inject ICategoryRepository CategoryRepository

<PageContainer Title="Category Page">
    <div class="container">
        <div class="row border border-1 p-1 shadow my-1 rounded-2">
            <div class="alert alert-dark">Create / Update</div>
            <div class="col-12">
                <div class="mb-2">
                    <label class="form-label">Category Title</label>
                    <input class="form-control" type="text" placeholder="Enter category" @bind="categoryTitle" />
                </div>
                <button class="btn btn-primary" @onclick="SaveCategory">Save</button>
            </div>
        </div>
        <div class="row border border-1 p-1 shadow my-1 rounded-2">
            <div class="alert alert-dark">Category List</div>
            <div class="col-12">
                <ul class="list-group">
                    @{
                        int counter = 1;
                        foreach (var item in _categories)
                        {
                            <li class="list-group-item d-flex flex-row justify-content-between">
                                <span>@(counter++) ) @item.Title</span>
                                <span>
                                    <button class="btn btn-outline-warning" @onclick="() => EditCategory(item)">Update</button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteCategory(item.Key)">Delete</button>
                                </span>
                            </li>
                        }

                    }
                </ul>
            </div>
        </div>
    </div>

</PageContainer>
@code {
    private List<Category> _categories = new();
    private string categoryTitle = string.Empty;
    private Guid? editingCategoryId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        var categories = await CategoryRepository.GetAsync(CancellationToken.None);
        _categories = categories.ToList();
    }

    private async Task SaveCategory()
    {
        if (!string.IsNullOrWhiteSpace(categoryTitle))
        {
            if (editingCategoryId.HasValue)
            {
                var category = _categories.FirstOrDefault(c => c.Key == editingCategoryId.Value);
                if (category != null)
                {
                    category.UpdateTitle(categoryTitle);
                    await CategoryRepository.SaveChangeAsync();
                }
            }
            else
            {
                var newCategory = new Category(categoryTitle);
                await CategoryRepository.CreateAsync(newCategory, CancellationToken.None);
                await CategoryRepository.SaveChangeAsync();
            }

            categoryTitle = string.Empty;
            editingCategoryId = null;
            await LoadCategories();
        }
    }

    private void EditCategory(Category category)
    {
        categoryTitle = category.Title;
        editingCategoryId = category.Key;
    }

    private async Task DeleteCategory(Guid categoryId)
    {
        var category = _categories.FirstOrDefault(c => c.Key == categoryId);
        if (category != null)
        {
            await CategoryRepository.DeleteAsync(category, CancellationToken.None);
            await LoadCategories();
        }
    }
}
